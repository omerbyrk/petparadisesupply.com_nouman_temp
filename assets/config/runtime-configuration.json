            "icon_code": 61445,
            "font_family": "FontAwesome5_Solid"
          }
        },
        {
          "title": "Try App Sharing Feature",
          "background_color": "#483D33",
          "foreground_color": "#FFFFFF",
          "url": "feature://app_sharing",
          "icon_spacing": 8.0,
          "icon": {
            "icon_code": 61540,
            "font_family": "FontAwesome5_Solid"
          }
        },
        {
          "title": "Try QRCode Feature",
          "background_color": "#483D33",
          "foreground_color": "#FFFFFF",
          "url": "feature://qr_code",
