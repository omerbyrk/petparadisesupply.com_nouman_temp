  "in_app_links": [
    "https://www.facebook.com/v3.3",
    "https://m.facebook.com/v3.3",
    "https://m.facebook.com(.)*",
    "(.)*accounts.google(.)*",
    "(.)*shopify.com(.)*",
    "(.)*shopify(.)*",
    "https://m.accounts.google.com/o/",
    "(.)*accounts.youtube(.)*",
    "(.)*calendly.com(.)*",
    "https://accounts.google.com/_/",
    "https://m.facebook.com/oauth",
    "https://m.facebook.com"
  ],
  "app_url_rules": [
    {
      "index": -1,
      "url": "(.)*play.google(.)*",
      "rule": "out"
    },
    {
      "index": -1,
      "url": "(.)*apps.apple(.)*",
      "rule": "out"
    },
    {
      "index": -1,
      "url": "(.)*twitter(.)*",
      "rule": "out"
    },
    {
      "index": -1,
      "url": "(.)*instagram(.)*",
      "rule": "out"
    },
    {
      "index": -1,
      "url": "(.)*map(.)*",
      "rule": "out"
    },
    {
      "index": 999,
      "url": "(.)*",
      "rule": "in"
    }
  ],
